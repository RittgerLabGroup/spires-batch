              "adapter": "curc",
              "role": "r0_source",
              "path": "reflectance",
              "pattern": "h??v??/*/VJ109GA.A*.h??v??.002.*.h5",
              "required": true
            }
          ]
        },
        "r0": {
          "mode": "build",
          "recipe": "viirs_summer_composite",
          "artifacts": [
