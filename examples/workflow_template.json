              "id": "noaa20-r0-h09v04-summer-2025",
              "path": "assets/r0_h09v04_summer2025.nc",
              "tile": "h09v04",
              "water_year": 2026,
              "start_date": "2025-06-01",
              "end_date": "2025-09-30"
            }
          ]
        },
        "science": {
          "build_r0": {
            "max_sensor_zenith": 30,
            "ndvi_tie_epsilon": 0.02,
            "min_blue_reflectance": 0.1,
            "show_progress": false
          }
        },
        "output": {
          "root": "daily-products",
          "product_contents": "full",
          "existing_file_handling": "write_new_file",
          "existing_output_policy": "error"
        },
        "execution": {
          "profile": "blanca-snow",
          "max_concurrent_tasks": 5,
          "max_auto_retry_count": 3,
          "resources": {
            "account": "blanca-snow",
            "qos": "blanca-snow",
            "time_limit": "08:00:00",
            "cpus_per_task": 1,
            "memory": "0",
            "environment_name": "spipy14",
            "extra_directives": [
              "--exclusive",
              "--dependency=singleton"
            ]
          },
          "staging": {
            "enabled": false,
            "verification": "stat",
            "reuse_valid": true
          }
        },
        "preflight": {
          "metadata_check": "sample"
        }
      }
    },
